# ─── TuitionFinder Web Client ─────────────────────────────────────────
# Copy this file to .env. Vite only exposes variables prefixed with VITE_.
# On Vercel these must be set as Project Environment Variables and the app
# must be REBUILT after any change (they are baked into the JS bundle).

# API base URL. Local dev: the Vite proxy handles /api, so either value works.
# Production: https://<your-server-domain>/api  (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Firebase Web app config — Firebase Console → Project settings → Your apps.
# These are public identifiers; they are safe to include in a client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
