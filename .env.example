# ─── TuitionFinder Web Client ─────────────────────────────────────────
# Copy this file to .env OR .env.local (both work locally; .env.local wins).
# Vite only exposes variables prefixed with VITE_.
# On Vercel these must be set as Project Environment Variables and the app
# must be REBUILT after any change (they are baked into the JS bundle).
# Write one KEY=value per line, with NO quotes, NO commas, NO trailing spaces.

# API base URL. Local dev: the Vite proxy handles /api, so either value works.
# Production: https://<your-server-domain>/api  (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Firebase Web app config — Firebase Console → Project settings → Your apps.
# Copy the values from the firebaseConfig snippet into these keys:
#   apiKey             → VITE_FIREBASE_API_KEY
#   authDomain         → VITE_FIREBASE_AUTH_DOMAIN
#   projectId          → VITE_FIREBASE_PROJECT_ID
#   storageBucket      → VITE_FIREBASE_STORAGE_BUCKET
#   messagingSenderId  → VITE_FIREBASE_MESSAGING_SENDER_ID
#   appId              → VITE_FIREBASE_APP_ID
# The JS snippet itself is already wired in src/firebase/config.js — do NOT
# paste it into any source file. These are public identifiers (safe in a bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
